# itoolbox-data-platform — local TimescaleDB + JupyterLab
# Copy to .env and fill in. Never commit the filled copy.

# ── Local TimescaleDB ───────────────────────────────────────────────────────────
TIMESCALE_DB=itoolbox_db
TIMESCALE_USER=itoolbox
TIMESCALE_PASSWORD=itoolbox
TIMESCALE_HOST_PORT=5436

# Used by scripts and notebooks running OUTSIDE the compose network.
# Inside the network the host is `itoolbox-timescaledb`, not `localhost`.
TIMESCALE_DB_URL=postgresql://itoolbox:itoolbox@localhost:5436/itoolbox_db

# ── Jupyter ─────────────────────────────────────────────────────────────────────
# 8888 and 8889 are the Zetaris API's.
JUPYTER_PORT=8890

# Leave blank to have Jupyter generate one and print it to the container logs.
JUPYTER_TOKEN=

# ── Ingestion ───────────────────────────────────────────────────────────────────
# OpenWeather (openweathermap.org), for itoolbox-ingest's hourly weather load. The
# free plan's current weather, 5-day forecast and air pollution APIs are enough;
# One Call 3.0/4.0 needs the separate "One Call by Call" subscription.
OPENWEATHER_API_KEY=

# ── BagyoAPI (self-hosted PAGASA bulletins) ─────────────────────────────────────
# 32+ random characters, for its internal HMACs. Required.
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
BAGYO_APP_SECRET=
# Only inside the compose network; change it before the first start if you like.
BAGYO_DB_PASSWORD=bagyo
BAGYO_API_PORT=3200
# false = seed data only, no live scraping of PAGASA.
BAGYO_LIVE_SCRAPING=true
